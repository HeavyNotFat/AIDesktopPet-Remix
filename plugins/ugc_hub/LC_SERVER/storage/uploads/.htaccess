# 上传目录：禁止执行任何脚本，禁止直接列出文件
php_flag engine off
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
RemoveHandler .php .phtml .phar .cgi .pl .py .asp .aspx .jsp .sh
AddType text/plain .php .phtml .phar .cgi .pl .py .asp .aspx .jsp .sh .js .mjs
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
Options -ExecCGI -Indexes
